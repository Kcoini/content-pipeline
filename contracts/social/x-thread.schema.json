{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://content-pipeline.local/contracts/social/x-thread.schema.json",
  "title": "x social post output contract",
  "description": "social_posts 저장 구조와 호환되는 x(트위터) 플랫폼 출력 계약. dry-run 전제이며 실제 X API 게시는 하지 않는다.",
  "type": "object",
  "properties": {
    "platform": { "const": "x" },
    "tone_style": {
      "type": "string",
      "enum": [
        "explanatory",
        "informational",
        "persuasive",
        "warning",
        "loss_aversion",
        "curiosity",
        "comparison",
        "story"
      ]
    },
    "post_title": { "type": ["string", "null"] },
    "post_body": { "type": ["string", "null"] },
    "caption": { "type": ["string", "null"] },
    "excerpt": { "type": ["string", "null"] },
    "hashtags": { "type": "array", "items": { "type": "string" } },
    "thread_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "order": { "type": "number" },
          "text": { "type": "string", "minLength": 1, "maxLength": 280 }
        },
        "required": ["order", "text"]
      }
    },
    "card_items": { "type": "array", "items": { "type": "object" } },
    "media_requirements": { "type": "object" },
    "platform_metadata": { "type": "object" },
    "safety_notes": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["platform", "tone_style", "thread_items"],
  "additionalProperties": true
}
