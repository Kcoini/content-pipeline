{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://content-pipeline.local/contracts/social/wordpress-blog.schema.json",
  "title": "wordpress_blog social post output contract",
  "description": "social_posts 저장 구조와 호환되는 wordpress_blog 플랫폼 출력 계약. 실제 공개 게시는 이 계약과 무관하게 별도의 Human Approval을 거쳐야 한다.",
  "type": "object",
  "properties": {
    "platform": { "const": "wordpress_blog" },
    "tone_style": {
      "type": "string",
      "enum": [
        "explanatory",
        "informational",
        "persuasive",
        "warning",
        "loss_aversion",
        "curiosity",
        "comparison",
        "story"
      ]
    },
    "post_title": { "type": "string", "minLength": 1 },
    "post_body": { "type": "string", "minLength": 1 },
    "caption": { "type": ["string", "null"] },
    "excerpt": { "type": ["string", "null"] },
    "hashtags": { "type": "array", "items": { "type": "string" } },
    "thread_items": { "type": "array", "items": { "type": "object" } },
    "card_items": { "type": "array", "items": { "type": "object" } },
    "media_requirements": { "type": "object" },
    "platform_metadata": { "type": "object" },
    "safety_notes": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["platform", "tone_style", "post_title", "post_body"],
  "additionalProperties": true
}
