/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# QA-01: Playwright — 생성된 fixture HTML/screenshot/report는 매번
