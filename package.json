{
  "name": "content-pipeline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "next build && vitest run --config vitest.e2e-fixtures.config.ts && playwright test",
    "ops:preflight": "vitest run --config vitest.ops.config.ts scripts/ops/preflight.ts",
    "ops:report-usage": "vitest run --config vitest.ops.config.ts scripts/ops/report-ai-usage.ts",
    "ops:audit-source-evidence": "vitest run --config vitest.ops.config.ts scripts/ops/audit-source-evidence.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@supabase/supabase-js": "^2.108.1",
    "js-yaml": "^4.1.0",
    "markdown-it": "^15.0.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
