NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Phase 1-4: AI 기사 생성 연동
# ANTHROPIC_API_KEY는 서버 코드(Server Action/Route Handler)에서만 사용한다.
# 절대 NEXT_PUBLIC_* 접두사를 붙이거나 client component에 노출하지 않는다.
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic
# true이면 AI 기사 생성을 사용하고, false(기본값)이면 mock generator를 사용한다.
AI_GENERATION_ENABLED=false

# Phase 1-12: 트렌드 기반 자동 테마 추출
# true이면 실제 네이버/다음 API를 사용하고, false(기본값)이면 mock 데이터를 사용한다.
TREND_COLLECTION_ENABLED=false
# Phase 1-13: 테마 키워드 기반 기사 URL 후보 수집
# true이면 실제 네이버/카카오 API를 사용하고, false(기본값)이면 mock 데이터를 사용한다.
ARTICLE_SEARCH_ENABLED=false
# 네이버 검색 API (https://developers.naver.com)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 카카오 REST API (https://developers.kakao.com) — 다음 뉴스 트렌드
KAKAO_REST_API_KEY=

# Phase 2-2 / 2-8: WordPress Draft Publish + Actual Connection Test
# WORDPRESS_APP_PASSWORD는 서버 코드(Server Action/publish service)에서만 사용한다.
# 절대 NEXT_PUBLIC_* 접두사를 붙이거나 client component에 노출하지 않는다.
# 이 값은 절대 실제 값으로 채우지 말고, 실제 값은 .env.local에만 저장한다 (.env.local은 커밋 금지).
# Application Password는 WordPress 관리자 > 사용자 > 프로필 > "응용 프로그램 비밀번호"에서 발급한다.
WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
# true이면 실제 WordPress REST API를 호출해 draft(초안)만 생성하고, false(기본값)이면 dry-run으로 처리한다.
# true여도 post status는 항상 draft로 강제되며, 공개(publish)는 절대 수행하지 않는다.
WORDPRESS_PUBLISH_ENABLED=false

# Phase 2-4 / 2-12: SEO Plugin Metadata Mapping + Actual Metadata Test
# 허용 값: none / yoast / rank_math / aioseo. 잘못된 값이면 none으로 대체된다.
# provider는 한 번에 하나만 선택해서 테스트한다 (여러 plugin 동시 write 금지).
SEO_PLUGIN_PROVIDER=none
# true이면 표준 WordPress REST API(POST /wp-json/wp/v2/posts/{id})의 meta
# 필드로 실제 SEO plugin metadata write를 시도한다 (draft post만 대상,
# 공개 게시는 하지 않음). plugin이 protected meta key를 REST에 노출하지
# 않으면 반영되지 않을 수 있다 (그 경우 custom endpoint가 필요할 수 있음).
SEO_PLUGIN_WRITE_ENABLED=false

# Phase 2-13: Custom WordPress SEO Metadata Endpoint (Rank Math 전용)
# true이면 표준 REST posts meta update 대신 WordPress custom REST endpoint
# (wordpress-plugin/ai-pipeline-seo-endpoint)를 통해 update_post_meta로
# 직접 저장을 시도한다. SEO_PLUGIN_PROVIDER=rank_math일 때만 사용되며,
# 실패해도 표준 REST 방식으로 fallback하지 않는다.
WORDPRESS_SEO_CUSTOM_ENDPOINT_ENABLED=false
# WordPress에 설치한 custom plugin이 등록하는 REST route 경로.
WORDPRESS_SEO_CUSTOM_ENDPOINT_PATH=/wp-json/ai-pipeline/v1/seo-meta

# Phase 2-6: WordPress Media Upload Preparation
# true여도 WORDPRESS_PUBLISH_ENABLED=true가 아니면 실제 WordPress API 호출은 하지 않는다.
# 실제 media upload는 아직 구현되지 않은 safe stub이다. 기본값은 반드시 false로 둔다.
WORDPRESS_MEDIA_UPLOAD_ENABLED=false

# Phase 2-7: Image Generation Integration
# 허용 값: mock / openai / custom. 기본값은 안전한 mock이다.
IMAGE_GENERATION_PROVIDER=mock
# true이면 IMAGE_GENERATION_PROVIDER의 실제 API를 호출하고, false(기본값)이면 mock으로 대체한다.
IMAGE_GENERATION_ENABLED=false
# 실제 provider 호출 시 사용할 기본 모델명 (예: dall-e-3). 비워두면 provider 기본값을 사용한다.
IMAGE_GENERATION_DEFAULT_MODEL=
# 실제 provider 호출 타임아웃 (ms)
IMAGE_GENERATION_TIMEOUT_MS=30000
# IMAGE_GENERATION_PROVIDER=openai일 때만 사용한다. 서버 코드에서만 사용하며
# 절대 NEXT_PUBLIC_* 접두사를 붙이거나 client component에 노출하지 않는다.
OPENAI_API_KEY=
# Phase 3-2: Multi-platform Writing — Prompt / Context / Contract Structure
# true이면 (다음 단계에서) 실제 Claude API를 호출해 platform/tone별 social
# post를 생성하고, false(기본값)이면 mock 생성으로 대체한다. 이번 단계에서는
# true로 설정해도 실제 AI 호출은 구현되어 있지 않다 (구조만 준비됨).
SOCIAL_AI_GENERATION_ENABLED=false
